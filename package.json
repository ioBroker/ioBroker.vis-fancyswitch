{
    "name": "iobroker.vis-fancyswitch",
    "description": "fancyswitch Widgets for ioBroker.vis and ioBroker.vis-2",
    "version": "1.1.0",
    "author": {
        "name": "bluefox",
        "email": "dogafox@gmail.com"
    },
    "contributors": [
        "bluefox <dogafox@gmail.com>",
        "Apollon77 <ingo@fischer-ka.de>"
    ],
    "homepage": "https://github.com/ioBroker/ioBroker.vis-fancyswitch",
    "repository": {
        "type": "git",
        "url": "https://github.com/ioBroker/ioBroker.vis-fancyswitch"
    },
    "keywords": [
        "ioBroker",
        "GUI",
        "DashUI",
        "web interface",
        "home automation",
        "SCADA",
        "fancyswitch GUI"
    ],
    "devDependencies": {
        "@alcalzone/release-script": "^5.1.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.1.2",
        "@alcalzone/release-script-plugin-license": "^5.1.1",
        "@iobroker/build-tools": "^3.0.3",
        "@iobroker/eslint-config": "^2.2.0",
        "@iobroker/testing": "^5.2.2"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/ioBroker.vis-fancyswitch/issues"
    },
    "main": "widgets/fancyswitch.html",
    "files": [
        "admin/",
        "img/",
        "widgets/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prepublishOnly": "npm run build",
        "build": "node tasks",
        "copy-files": "node tasks --copy-files",
        "tsc": "cd src-widgets && npx tsc",
        "check-widgets": "cd src-widgets && node checkWidgets.mjs",
        "assets": "cd src-widgets && node makeAssets.mjs",
        "preview": "cd src-widgets && npm run preview",
        "lint": "eslint -c eslint.config.mjs",
        "test": "mocha --exit",
        "test:integration": "mocha --exit",
        "test:package": "mocha test/testPackageFiles --exit",
        "npm": "npm i && cd src-widgets && npm i",
        "update-packages": "npx -y npm-check-updates --upgrade && cd src-widgets && npx -y npm-check-updates --upgrade",
        "release": "release-script",
        "release-patch": "release-script patch --yes --no-update-lockfile",
        "release-minor": "release-script minor --yes --no-update-lockfile",
        "release-major": "release-script major --yes --no-update-lockfile"
    },
    "license": "Apache-2.0"
}
